# ---------------------------------------------------------------------------
# Ideon · Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ---------------------------------------------------------------------------

# URL pública de la app (redirecciones de autenticación, metadatos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Fase 1) — Proyecto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Fase 2 — Inteligencia
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AGENT_ENGINE_URL=

# Fase 5 — Comercialización
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_EVENTS_SECRET=
