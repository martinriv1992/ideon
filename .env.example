# ---------------------------------------------------------------------------
# Ideon · Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# ---------------------------------------------------------------------------

# URL pública de la app (redirecciones de autenticación, metadatos)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# (Opcional) URL base para los sitios publicados, si se sirven desde otro dominio (p. ej. https://sites.ideon.app)
NEXT_PUBLIC_SITE_BASE_URL=

# Supabase (Fase 1) — Proyecto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA exponer al navegador. Lo usan los agentes, la publicación y el backoffice.
SUPABASE_SERVICE_ROLE_KEY=

# Inteligencia (Fase 2) — proveedor de modelos
ANTHROPIC_API_KEY=
# AI_PROVIDER=mock   # solo para pruebas locales sin clave: respuestas deterministas, nunca en producción

# Publicación y dominios — el hosting en Ideon (/s/<slug>) no lo necesita.
# VERCEL_TOKEN + VERCEL_TEAM_ID + VERCEL_PROJECT_ID (el proyecto de la plataforma en Vercel)
# activan la búsqueda y compra de dominios: se cargan al método de pago de la cuenta de Vercel.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_SITES_PROJECT=

# Comercialización (Fase 5) — opcional hasta activar pagos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# ePayco (Colombia) — pagos del lanzamiento (vista previa → proyecto activado) y renovaciones anuales.
# Panel de ePayco → Integraciones → Llaves API. URL de confirmación: <APP_URL>/api/billing/epayco/confirmation
EPAYCO_PUBLIC_KEY=
EPAYCO_P_CUST_ID_CLIENTE=
EPAYCO_P_KEY=
EPAYCO_TEST=true
# Wompi (Colombia) — adaptador previsto
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # Cloudflare Turnstile (captcha en registro e inicio de sesión); el secreto va en Supabase Auth
